<UserControl x:Class="XenoKit.Views.BCM.BcmEntryEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:local="clr-namespace:XenoKit.Views.BCM"
             xmlns:converters="clr-namespace:XenoKit.Converters"
             xmlns:bcmDic="clr-namespace:Xv2CoreLib.ValuesDictionary;assembly=Xv2CoreLib">
    <UserControl.Resources>
        <converters:UIntValueEqualsConverter x:Key="uintEquals"/>

        <Style x:Key="BcmRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>

        <Style x:Key="BcmLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="150"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,12,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}"/>
        </Style>

        <!-- These must stay based on the MahApps implicit styles. Without BasedOn, setting Style at all
             drops the themed template and the controls render as light theme WPF defaults. -->
        <Style x:Key="BcmGroup" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <!-- Width is fixed, so without an explicit alignment WPF centres these inside a vertical StackPanel.
             Harmless for the groups that sit in a WrapPanel, wrong for the two Mode groups that do not. -->
        <Style x:Key="BcmChoiceStack" TargetType="StackPanel">
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BcmSubHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </UserControl.Resources>

    <Grid MinWidth="420">
        <TextBlock x:Name="emptyTextBlock"
                   Text="Select a child state. Root states cannot be edited."
                   Foreground="{DynamicResource MahApps.Brushes.Text}"
                   Margin="10"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
        <Controls:MetroTabControl x:Name="tabControl"
                                  Style="{DynamicResource UnderlinedTabControl}">

            <Controls:MetroTabItem Header="Inputs" Controls:HeaderedControlHelper.HeaderFontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" DataContext="{Binding BcmViewModel, RelativeSource={RelativeSource AncestorType={x:Type local:BcmEntryEditor}}}">

                        <GroupBox Style="{StaticResource BcmGroup}" Header="Directional Input">
                            <WrapPanel>
                                <StackPanel Style="{StaticResource BcmChoiceStack}">
                                    <TextBlock Text="User Direction" Style="{StaticResource BcmSubHeader}"/>
                                    <Separator/>
                                    <CheckBox Content="Input activated once" IsChecked="{Binding Dir_SingleActivation}"/>
                                    <CheckBox Content="Up" IsChecked="{Binding Dir_Up}"/>
                                    <CheckBox Content="Down" IsChecked="{Binding Dir_Down}"/>
                                    <CheckBox Content="Left" IsChecked="{Binding Dir_Left}"/>
                                    <CheckBox Content="Right" IsChecked="{Binding Dir_Right}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource BcmChoiceStack}">
                                    <TextBlock Text="Player Direction" Style="{StaticResource BcmSubHeader}"/>
                                    <Separator/>
                                    <CheckBox Content="Forwards" IsChecked="{Binding Dir_Forward}"/>
                                    <CheckBox Content="Backwards" IsChecked="{Binding Dir_Backwards}"/>
                                    <CheckBox Content="Left" IsChecked="{Binding Dir_LeftRelative}"/>
                                    <CheckBox Content="Right" IsChecked="{Binding Dir_RightRelative}"/>
                                </StackPanel>
                            </WrapPanel>
                        </GroupBox>

                        <GroupBox Style="{StaticResource BcmGroup}" Header="Button Input">
                            <WrapPanel>
                                <StackPanel Style="{StaticResource BcmChoiceStack}">
                                    <CheckBox Content="Lock On" IsChecked="{Binding Btn_LockOn}"/>
                                    <CheckBox Content="Descend" IsChecked="{Binding Btn_Descend}"/>
                                    <CheckBox Content="Dragon Radar" IsChecked="{Binding Btn_DragonRadar}"/>
                                    <CheckBox Content="Jump 2" IsChecked="{Binding Btn_Jump_2}"/>
                                    <CheckBox Content="Ultimate Menu" IsChecked="{Binding Btn_UltimateMenu}"/>
                                    <CheckBox Content="Skill Input" IsChecked="{Binding Btn_SkillInput}"/>
                                    <CheckBox Content="Super Menu Plus Skill Input" IsChecked="{Binding Btn_SuperMenuPlusSkillInput}"/>
                                    <CheckBox Content="Ultimate Menu Plus Skill Input" IsChecked="{Binding Btn_UltimateMenuPlusSkillInput}"/>
                                    <CheckBox Content="Unk20" IsChecked="{Binding Btn_Unk20}"/>
                                    <CheckBox Content="Ultimate Skill1" IsChecked="{Binding Btn_UltimateSkill1}"/>
                                    <CheckBox Content="Ultimate Skill2" IsChecked="{Binding Btn_UltimateSkill2}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource BcmChoiceStack}">
                                    <CheckBox Content="Awoken Skill" IsChecked="{Binding Btn_AwokenSkill}"/>
                                    <CheckBox Content="Evasive Skill" IsChecked="{Binding Btn_EvasiveSkill}"/>
                                    <CheckBox Content="Super Skill1" IsChecked="{Binding Btn_SuperSkill1}"/>
                                    <CheckBox Content="Super Skill2" IsChecked="{Binding Btn_SuperSkill2}"/>
                                    <CheckBox Content="Super Skill3" IsChecked="{Binding Btn_SuperSkill3}"/>
                                    <CheckBox Content="Super Skill4" IsChecked="{Binding Btn_SuperSkill4}"/>
                                    <CheckBox Content="Skill Menu" IsChecked="{Binding Btn_SkillMenu}"/>
                                    <CheckBox Content="Boost" IsChecked="{Binding Btn_Boost}"/>
                                    <CheckBox Content="Guard" IsChecked="{Binding Btn_Guard}"/>
                                    <CheckBox Content="Unk8" IsChecked="{Binding Btn_Unk8}"/>
                                    <CheckBox Content="Light" IsChecked="{Binding Btn_Light}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource BcmChoiceStack}">
                                    <CheckBox Content="Heavy" IsChecked="{Binding Btn_Heavy}"/>
                                    <CheckBox Content="Blast" IsChecked="{Binding Btn_Blast}"/>
                                    <CheckBox Content="Jump" IsChecked="{Binding Btn_Jump}"/>
                                    <CheckBox Content="Unk26" IsChecked="{Binding Btn_Unk26}"/>
                                    <CheckBox Content="Unk27" IsChecked="{Binding Btn_Unk27}"/>
                                    <CheckBox Content="Unk28" IsChecked="{Binding Btn_Unk28}"/>
                                    <CheckBox Content="Ultimate Menu 2" IsChecked="{Binding Btn_UltimateMenu_2}"/>
                                    <CheckBox Content="Unk30" IsChecked="{Binding Btn_Unk30}"/>
                                    <CheckBox Content="Unk31" IsChecked="{Binding Btn_Unk31}"/>
                                    <CheckBox Content="Unk32" IsChecked="{Binding Btn_Unk32}"/>
                                </StackPanel>
                            </WrapPanel>
                        </GroupBox>

                        <GroupBox Style="{StaticResource BcmGroup}" Header="Hold Down Conditions">
                            <StackPanel>
                                <DockPanel Style="{StaticResource BcmRow}">
                                    <TextBlock Style="{StaticResource BcmLabel}" Text="Raw Value" ToolTip="Full HoldDownConditions value, including any bits the options below do not cover."/>
                                    <TextBox IsReadOnly="True" Text="{Binding HoldDownConditionsHex, Mode=OneWay}"/>
                                </DockPanel>
                                <WrapPanel>
                                    <StackPanel Style="{StaticResource BcmChoiceStack}">
                                        <TextBlock Text="Charge Type" Style="{StaticResource BcmSubHeader}"/>
                                        <Separator/>
                                        <RadioButton GroupName="ChargeType" Content="Automatic" IsChecked="{Binding HoldDown_ChargeType, Converter={StaticResource uintEquals}, ConverterParameter=0}"/>
                                        <RadioButton GroupName="ChargeType" Content="Manual" IsChecked="{Binding HoldDown_ChargeType, Converter={StaticResource uintEquals}, ConverterParameter=1}"/>
                                        <RadioButton GroupName="ChargeType" Content="Hold down to loop" IsChecked="{Binding HoldDown_ChargeType, Converter={StaticResource uintEquals}, ConverterParameter=2}"/>
                                        <RadioButton GroupName="ChargeType" Content="Unknown (0x3)" IsChecked="{Binding HoldDown_ChargeType, Converter={StaticResource uintEquals}, ConverterParameter=3}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource BcmChoiceStack}">
                                        <TextBlock Text="Options #2" Style="{StaticResource BcmSubHeader}"/>
                                        <Separator/>
                                        <RadioButton GroupName="Options2" Content="Unknown (0x0)" IsChecked="{Binding HoldDown_Options2, Converter={StaticResource uintEquals}, ConverterParameter=0}"/>
                                        <RadioButton GroupName="Options2" Content="Unknown (0x1)" IsChecked="{Binding HoldDown_Options2, Converter={StaticResource uintEquals}, ConverterParameter=1}"/>
                                        <RadioButton GroupName="Options2" Content="Unknown (0x2)" IsChecked="{Binding HoldDown_Options2, Converter={StaticResource uintEquals}, ConverterParameter=2}"/>
                                        <RadioButton GroupName="Options2" Content="Unknown (0x3)" IsChecked="{Binding HoldDown_Options2, Converter={StaticResource uintEquals}, ConverterParameter=3}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource BcmChoiceStack}">
                                        <TextBlock Text="Options #3" Style="{StaticResource BcmSubHeader}"/>
                                        <Separator/>
                                        <RadioButton GroupName="Options3" Content="Unknown (0x0)" IsChecked="{Binding HoldDown_Options3, Converter={StaticResource uintEquals}, ConverterParameter=0}"/>
                                        <RadioButton GroupName="Options3" Content="Unknown (0x1)" IsChecked="{Binding HoldDown_Options3, Converter={StaticResource uintEquals}, ConverterParameter=1}"/>
                                        <RadioButton GroupName="Options3" Content="Unknown (0x2)" IsChecked="{Binding HoldDown_Options3, Converter={StaticResource uintEquals}, ConverterParameter=2}"/>
                                        <RadioButton GroupName="Options3" Content="Unknown (0x3)" IsChecked="{Binding HoldDown_Options3, Converter={StaticResource uintEquals}, ConverterParameter=3}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource BcmChoiceStack}">
                                        <TextBlock Text="Options #4" Style="{StaticResource BcmSubHeader}"/>
                                        <Separator/>
                                        <RadioButton GroupName="Options4" Content="Unknown (0x0)" IsChecked="{Binding HoldDown_Options4, Converter={StaticResource uintEquals}, ConverterParameter=0}"/>
                                        <RadioButton GroupName="Options4" Content="Unknown (0x1)" IsChecked="{Binding HoldDown_Options4, Converter={StaticResource uintEquals}, ConverterParameter=1}"/>
                                        <RadioButton GroupName="Options4" Content="Unknown (0x2)" IsChecked="{Binding HoldDown_Options4, Converter={StaticResource uintEquals}, ConverterParameter=2}"/>
                                        <RadioButton GroupName="Options4" Content="Unknown (0x3)" IsChecked="{Binding HoldDown_Options4, Converter={StaticResource uintEquals}, ConverterParameter=3}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource BcmChoiceStack}">
                                        <TextBlock Text="Behaviour" Style="{StaticResource BcmSubHeader}"/>
                                        <Separator/>
                                        <RadioButton GroupName="Behaviour" Content="Continue until released" IsChecked="{Binding HoldDown_Behaviour, Converter={StaticResource uintEquals}, ConverterParameter=0}"/>
                                        <RadioButton GroupName="Behaviour" Content="Delay until released" IsChecked="{Binding HoldDown_Behaviour, Converter={StaticResource uintEquals}, ConverterParameter=1}"/>
                                        <RadioButton GroupName="Behaviour" Content="Unknown (0x2)" IsChecked="{Binding HoldDown_Behaviour, Converter={StaticResource uintEquals}, ConverterParameter=2}"/>
                                        <RadioButton GroupName="Behaviour" Content="Stop skill from activating" IsChecked="{Binding HoldDown_Behaviour, Converter={StaticResource uintEquals}, ConverterParameter=4}"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Controls:MetroTabItem>

            <Controls:MetroTabItem Header="Activator" Controls:HeaderedControlHelper.HeaderFontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" DataContext="{Binding BcmViewModel, RelativeSource={RelativeSource AncestorType={x:Type local:BcmEntryEditor}}}">

                        <GroupBox Style="{StaticResource BcmGroup}" Header="Mode">
                            <StackPanel>
                                <DockPanel Style="{StaticResource BcmRow}">
                                    <TextBlock Style="{StaticResource BcmLabel}" Text="Raw Value" ToolTip="Full I_00 value, including any bits the options below do not cover."/>
                                    <TextBox IsReadOnly="True" Text="{Binding ActivatorModeHex, Mode=OneWay}"/>
                                </DockPanel>
                                <StackPanel Style="{StaticResource BcmChoiceStack}">
                                    <RadioButton GroupName="ActivatorMode" Content="None" IsChecked="{Binding ActivatorMode, Converter={StaticResource uintEquals}, ConverterParameter=0}"/>
                                    <RadioButton GroupName="ActivatorMode" Content="Use Skill Upgrades" IsChecked="{Binding ActivatorMode, Converter={StaticResource uintEquals}, ConverterParameter=1}"/>
                                    <RadioButton GroupName="ActivatorMode" Content="Opponent Reached Ground" IsChecked="{Binding ActivatorMode, Converter={StaticResource uintEquals}, ConverterParameter=16}"/>
                                    <RadioButton GroupName="ActivatorMode" Content="Unknown (0x2)" IsChecked="{Binding ActivatorMode, Converter={StaticResource uintEquals}, ConverterParameter=2}"/>
                                    <RadioButton GroupName="ActivatorMode" Content="Unknown (0x4)" IsChecked="{Binding ActivatorMode, Converter={StaticResource uintEquals}, ConverterParameter=4}"/>
                                    <RadioButton GroupName="ActivatorMode" Content="Unknown (0x8)" IsChecked="{Binding ActivatorMode, Converter={StaticResource uintEquals}, ConverterParameter=8}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="Character Condition" ToolTip="Selects which character class can use this state."/>
                            <ComboBox ItemsSource="{x:Static bcmDic:BCM.CharacterCondition}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding CharacterCondition, UpdateSourceTrigger=Default}" ToolTip="Select a character class for this state."/>
                        </DockPanel>

                        <StackPanel Visibility="{Binding UpgradeLevelVisibility}">
                            <DockPanel Style="{StaticResource BcmRow}">
                                <TextBlock Style="{StaticResource BcmLabel}" Text="Upgrade Level" ToolTip="Opponent Size Conditions mapped as 0x1000000 per level. Level 0 = 0x0, Level 4 = 0x4000000"/>
                                <Controls:NumericUpDown Minimum="0" Maximum="255" Value="{Binding UpgradeLevel, UpdateSourceTrigger=Default}"/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding OpponentSizeVisibility}">
                            <DockPanel Style="{StaticResource BcmRow}">
                                <TextBlock Style="{StaticResource BcmLabel}" Text="Opponent Size" ToolTip="Requirements based on character CMS size entries."/>
                                <ComboBox ItemsSource="{x:Static bcmDic:BCM.OpponentSize}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding OpponentSizeFamily}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource BcmRow}">
                                <TextBlock Style="{StaticResource BcmLabel}" Text="Size Unknown" ToolTip="Low unknown bits for opponent size conditions."/>
                                <ComboBox ItemsSource="{x:Static bcmDic:BCM.OpponentSizeUnknown}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding OpponentSizeUnknown}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource BcmRow}">
                                <TextBlock Style="{StaticResource BcmLabel}" Text="Size Raw Value"/>
                                <TextBox IsReadOnly="True" Text="{Binding OpponentSizeConditionsHex, Mode=OneWay}"/>
                            </DockPanel>
                        </StackPanel>

                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="Minimum Loop Duration" ToolTip="Minimum Loop Duration"/>
                            <Controls:NumericUpDown Minimum="0" Maximum="65535" Value="{Binding MinimumLoopDuration, UpdateSourceTrigger=Default}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="Maximum Loop Duration" ToolTip="Maximum Loop Duration"/>
                            <Controls:NumericUpDown Minimum="0" Maximum="65535" Value="{Binding MaximumLoopDuration, UpdateSourceTrigger=Default}"/>
                        </DockPanel>

                        <GroupBox Style="{StaticResource BcmGroup}" Header="BCM Callback">
                            <DockPanel Style="{StaticResource BcmRow}">
                                <TextBlock Style="{StaticResource BcmLabel}" Text="Receiver Link Id" ToolTip="Matches the BCM Callback link value. Combos = 0x1, Supers = 0x2, Ultimate / Awoken / Evasive = 0x4."/>
                                <ComboBox ItemsSource="{x:Static bcmDic:BCM.ReceiverLinkId}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding ReceiverLinkID}"/>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Style="{StaticResource BcmGroup}" Header="Resource">
                            <StackPanel>
                                <DockPanel Style="{StaticResource BcmRow}">
                                    <TextBlock Style="{StaticResource BcmLabel}" Text="Ki Cost" ToolTip="Ki Cost"/>
                                    <Controls:NumericUpDown Minimum="0" Value="{Binding KiCost, UpdateSourceTrigger=Default}"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource BcmRow}">
                                    <TextBlock Style="{StaticResource BcmLabel}" Text="Stamina Cost" ToolTip="Stamina Cost"/>
                                    <Controls:NumericUpDown Minimum="0" Value="{Binding StaminaCost, UpdateSourceTrigger=Default}"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource BcmRow}">
                                    <TextBlock Style="{StaticResource BcmLabel}" Text="Ki Required" ToolTip="Ki Required"/>
                                    <Controls:NumericUpDown Minimum="0" Value="{Binding KiRequired, UpdateSourceTrigger=Default}"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource BcmRow}">
                                    <TextBlock Style="{StaticResource BcmLabel}" Text="Health Required" ToolTip="Health Required"/>
                                    <Controls:NumericUpDown StringFormat="0.0#######" Value="{Binding HealthRequired, UpdateSourceTrigger=Default}"/>
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Style="{StaticResource BcmGroup}" Header="User State">
                            <StackPanel>
                                <DockPanel Style="{StaticResource BcmRow}">
                                    <TextBlock Style="{StaticResource BcmLabel}" Text="CUS Aura" ToolTip="CUS Aura"/>
                                    <Controls:NumericUpDown Minimum="-32768" Maximum="32767" Value="{Binding CusAura, UpdateSourceTrigger=Default}"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource BcmRow}">
                                    <TextBlock Style="{StaticResource BcmLabel}" Text="Transformation Stage" ToolTip="Transformation Stage"/>
                                    <Controls:NumericUpDown Minimum="-32768" Maximum="32767" Value="{Binding TransStage, UpdateSourceTrigger=Default}"/>
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Style="{StaticResource BcmGroup}" Header="Primary Conditions">
                            <WrapPanel>
                                <StackPanel Style="{StaticResource BcmChoiceStack}">
                                    <TextBlock Text="Opponent State" Style="{StaticResource BcmSubHeader}"/>
                                    <Separator/>
                                    <CheckBox Content="Health &lt; 25%" IsChecked="{Binding Pri_TargetsHealthLessThan25}"/>
                                    <CheckBox Content="In Knockback" IsChecked="{Binding Pri_OpponentKnockback}"/>
                                    <CheckBox Content="Being Targeted" IsChecked="{Binding Pri_TargetingOpponent}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource BcmChoiceStack}">
                                    <TextBlock Text="BAC Callback" Style="{StaticResource BcmSubHeader}"/>
                                    <Separator/>
                                    <CheckBox Content="When an attack hits" IsChecked="{Binding Pri_OnAttackHit}"/>
                                    <CheckBox Content="Running BAC Entry attack Hits" IsChecked="{Binding Pri_CurrentBacEntryHits}"/>
                                    <CheckBox Content="Pass when Guarding" ToolTip="When this is active, the BCM condition &quot;Attack hit&quot; or &quot;Running BAC Entry Attack hit&quot; pass even when opponent is guarding." IsChecked="{Binding Pri_AttackBlocked}"/>
                                    <CheckBox Content="Active Projectile" IsChecked="{Binding Pri_ActiveProjectile}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource BcmChoiceStack}">
                                    <TextBlock Text="User State" Style="{StaticResource BcmSubHeader}"/>
                                    <Separator/>
                                    <CheckBox Content="User's Health &lt; 25% (One Use)" IsChecked="{Binding Pri_UsersHealth_OneUse}"/>
                                    <CheckBox Content="User's Health &lt; 25%" IsChecked="{Binding Pri_UsersHealth}"/>
                                    <CheckBox Content="Transformed" IsChecked="{Binding Pri_InTransformedState}"/>
                                    <CheckBox Content="Base form" IsChecked="{Binding Pri_InBaseForm}"/>
                                    <CheckBox Content="Not Moving" IsChecked="{Binding Pri_Idle}"/>
                                    <CheckBox Content="Flash on/off unless targeting" IsChecked="{Binding Pri_Unk10}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource BcmChoiceStack}">
                                    <TextBlock Text="Position" Style="{StaticResource BcmSubHeader}"/>
                                    <Separator/>
                                    <CheckBox Content="Standing" IsChecked="{Binding Pri_Standing}"/>
                                    <CheckBox Content="Floating" IsChecked="{Binding Pri_Floating}"/>
                                    <CheckBox Content="Touching &quot;ground&quot;" IsChecked="{Binding Pri_TouchingGround}"/>
                                    <CheckBox Content="Close to opponent" IsChecked="{Binding Pri_CloseToTarget}"/>
                                    <CheckBox Content="Far from opponent" IsChecked="{Binding Pri_FarFromTarget}"/>
                                    <CheckBox Content="Not near map ceiling" IsChecked="{Binding Pri_NotNearStageCeiling}"/>
                                    <CheckBox Content="Not near certain objects" IsChecked="{Binding Pri_NotNearCertainObjects}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource BcmChoiceStack}">
                                    <TextBlock Text="Resource" Style="{StaticResource BcmSubHeader}"/>
                                    <Separator/>
                                    <CheckBox Content="Stamina &gt; 0%" IsChecked="{Binding Pri_StaminaAboveZero}"/>
                                    <CheckBox Content="Pass when Stamina Reaches 0" IsChecked="{Binding Pri_CounterProjectile}"/>
                                    <CheckBox Content="Ki &lt; 100%" IsChecked="{Binding Pri_KiBelow100}"/>
                                    <CheckBox Content="Ki &gt; 0%" IsChecked="{Binding Pri_KiAboveZero}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource BcmChoiceStack}">
                                    <TextBlock Text="Counter" Style="{StaticResource BcmSubHeader}"/>
                                    <Separator/>
                                    <CheckBox Content="Counter Melee" IsChecked="{Binding Pri_Unk17}"/>
                                    <CheckBox Content="Counter Projectiles" IsChecked="{Binding Pri_Unk18}"/>
                                    <CheckBox Content="Counter All" IsChecked="{Binding Pri_CounterMelee}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource BcmChoiceStack}">
                                    <TextBlock Text="Touching" Style="{StaticResource BcmSubHeader}"/>
                                    <Separator/>
                                    <CheckBox Content="Ground" IsChecked="{Binding Pri_Ground}"/>
                                    <CheckBox Content="Opponent" IsChecked="{Binding Pri_Opponent}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource BcmChoiceStack}">
                                    <TextBlock Text="Unknown" Style="{StaticResource BcmSubHeader}"/>
                                    <Separator/>
                                    <CheckBox Content="Unknown (0x4)" IsChecked="{Binding Pri_Unk11}"/>
                                    <CheckBox Content="Unknown (0x2)" IsChecked="{Binding Pri_Unk22}"/>
                                    <CheckBox Content="Unknown (0x8)" IsChecked="{Binding Pri_Unk24}"/>
                                </StackPanel>
                            </WrapPanel>
                        </GroupBox>

                        <GroupBox Style="{StaticResource BcmGroup}" Header="Activator State">
                            <WrapPanel>
                                <StackPanel Style="{StaticResource BcmChoiceStack}">
                                    <TextBlock Text="State" Style="{StaticResource BcmSubHeader}"/>
                                    <Separator/>
                                    <CheckBox Content="Receiving Damage" IsChecked="{Binding State_ReceivingDamage}"/>
                                    <CheckBox Content="Jumping" IsChecked="{Binding State_Jumping}"/>
                                    <CheckBox Content="Not being damaged" IsChecked="{Binding State_NotReceivingDamage}"/>
                                    <CheckBox Content="Target attacking player" IsChecked="{Binding State_TargetIsAttacking}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource BcmChoiceStack}">
                                    <TextBlock Text="Action" Style="{StaticResource BcmSubHeader}"/>
                                    <Separator/>
                                    <CheckBox Content="Idle" IsChecked="{Binding State_Idle}"/>
                                    <CheckBox Content="Combo/skill" IsChecked="{Binding State_Attacking}"/>
                                    <CheckBox Content="Boosting" IsChecked="{Binding State_Boosting}"/>
                                    <CheckBox Content="Guarding" IsChecked="{Binding State_Guarding}"/>
                                </StackPanel>
                            </WrapPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Controls:MetroTabItem>

            <Controls:MetroTabItem Header="BAC" Controls:HeaderedControlHelper.HeaderFontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" DataContext="{Binding BcmViewModel, RelativeSource={RelativeSource AncestorType={x:Type local:BcmEntryEditor}}}">
                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="Primary BAC" ToolTip="Primary BAC"/>
                            <Controls:NumericUpDown Minimum="-32768" Maximum="32767" Value="{Binding BacEntryPrimary, UpdateSourceTrigger=Default}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="Charge BAC" ToolTip="Charge BAC"/>
                            <Controls:NumericUpDown Minimum="-32768" Maximum="32767" Value="{Binding BacEntryCharge, UpdateSourceTrigger=Default}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="User Connect BAC" ToolTip="User Connect BAC"/>
                            <Controls:NumericUpDown Minimum="-32768" Maximum="32767" Value="{Binding BacEntryUserConnect, UpdateSourceTrigger=Default}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="Victim Connect BAC" ToolTip="Victim Connect BAC"/>
                            <Controls:NumericUpDown Minimum="-32768" Maximum="32767" Value="{Binding BacEntryVictimConnect, UpdateSourceTrigger=Default}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="Airborne BAC" ToolTip="Airborne BAC"/>
                            <Controls:NumericUpDown Minimum="-32768" Maximum="32767" Value="{Binding BacEntryAirborne, UpdateSourceTrigger=Default}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="Targeting Override BAC" ToolTip="Targeting Override BAC"/>
                            <Controls:NumericUpDown Minimum="0" Maximum="65535" Value="{Binding BacEntryTargetingOverride, UpdateSourceTrigger=Default}"/>
                        </DockPanel>

                        <GroupBox Style="{StaticResource BcmGroup}" Header="Mode">
                            <StackPanel>
                                <DockPanel Style="{StaticResource BcmRow}">
                                    <TextBlock Style="{StaticResource BcmLabel}" Text="Raw Value" ToolTip="Full RandomFlag value, including any bits the options below do not cover."/>
                                    <TextBox IsReadOnly="True" Text="{Binding BacModeHex, Mode=OneWay}"/>
                                </DockPanel>
                                <StackPanel Style="{StaticResource BcmChoiceStack}">
                                    <RadioButton GroupName="BacMode" Content="None" IsChecked="{Binding BacMode, Converter={StaticResource uintEquals}, ConverterParameter=0}"/>
                                    <RadioButton GroupName="BacMode" Content="Random BAC Entry" IsChecked="{Binding BacMode, Converter={StaticResource uintEquals}, ConverterParameter=1}"/>
                                    <RadioButton GroupName="BacMode" Content="No Target Correction" IsChecked="{Binding BacMode, Converter={StaticResource uintEquals}, ConverterParameter=2}"/>
                                    <RadioButton GroupName="BacMode" Content="3 Instance Setup" IsChecked="{Binding BacMode, Converter={StaticResource uintEquals}, ConverterParameter=3}"/>
                                    <RadioButton GroupName="BacMode" Content="Unknown (0x4)" IsChecked="{Binding BacMode, Converter={StaticResource uintEquals}, ConverterParameter=4}"/>
                                    <RadioButton GroupName="BacMode" Content="Unknown (0x6)" IsChecked="{Binding BacMode, Converter={StaticResource uintEquals}, ConverterParameter=6}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Controls:MetroTabItem>

            <Controls:MetroTabItem Header="Misc" Controls:HeaderedControlHelper.HeaderFontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" DataContext="{Binding BcmViewModel, RelativeSource={RelativeSource AncestorType={x:Type local:BcmEntryEditor}}}">
                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="Sibling Idx" ToolTip="Sibling Idx"/>
                            <TextBox Text="{Binding SiblingIndex, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="Child Idx" ToolTip="Child Idx"/>
                            <TextBox Text="{Binding ChildIndex, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Controls:MetroTabItem>

            <Controls:MetroTabItem Header="Unknown" Controls:HeaderedControlHelper.HeaderFontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" DataContext="{Binding BcmViewModel, RelativeSource={RelativeSource AncestorType={x:Type local:BcmEntryEditor}}}">
                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="I_00" ToolTip="I_00"/>
                            <TextBox Text="{Binding I_00Hex, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="I_36" ToolTip="I_36"/>
                            <TextBox Text="{Binding I_36Hex, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="I_68" ToolTip="I_68"/>
                            <TextBox Text="{Binding I_68Hex, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="I_72" ToolTip="I_72"/>
                            <TextBox Text="{Binding I_72Hex, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="I_80" ToolTip="I_80"/>
                            <TextBox Text="{Binding I_80Hex, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="I_88" ToolTip="I_88"/>
                            <TextBox Text="{Binding I_88Hex, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="I_104" ToolTip="Extra state requirements. The checkbox below covers the one confirmed flag. Other bits stay in the raw value."/>
                            <TextBox Text="{Binding I_104Hex, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource BcmRow}">
                            <TextBlock Style="{StaticResource BcmLabel}" Text="I_104 known flag" ToolTip="This checkbox edits the one I_104 flag with a confirmed meaning. Other bits stay in the raw value."/>
                            <StackPanel>
                                <CheckBox Content="Minimum skill upgrade level (0x1)" IsChecked="{Binding I104_MinimumSkillUpgradeLevel}" ToolTip="Requires the skill's upgrade level to meet the threshold in the upper byte of Opponent Size Conditions."/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Controls:MetroTabItem>
        </Controls:MetroTabControl>
    </Grid>
</UserControl>
